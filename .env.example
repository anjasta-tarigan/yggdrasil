# Provider secrets — one per provider id, referenced by apiKeyEnv in data/providers.json
# PROVIDER_SERVER_API_KEY=sk-...
# PROVIDER_<ID>_API_KEY=sk-...
# LLM_* vars below are deprecated first-boot seeds only; editing baseUrl in the UI now wins.
LLM_BASE_URL=http://localhost:20128/v1
LLM_MODEL_ID=ps/poolside/laguna-s-2.1
LLM_API_KEY=your_key_here

# Web & Image Search Providers (used by web_search and image_search tools)
# Any one is enough: the tools fall back through the enabled chain
# (Exa -> SearXNG -> Firecrawl) when a provider fails or runs out of
# quota. Provider priority, enable flags and key/URL overrides can also
# be managed in Settings -> Tools.
EXA_API_KEY=your_key_here
FIRECRAWL_API_KEY=your_key_here
# Self-hosted SearXNG instance (no API key). Enable the JSON format on
# the instance first: search.formats: [html, json] in its settings.yml.
# SEARXNG_BASE_URL=http://localhost:8080

# Neural Reranker (bge-reranker-v2-m3 ONNX INT8)
# To activate cross-encoder reranking, manually download and place
# bge-reranker-v2-m3-int8.onnx (~544 MB) into data/models/
# When absent, the system automatically falls back to default cosine RRF.
# Set true to opt in; a local ONNX model is also required.
# RERANKER_ENABLED=true
# RERANKER_MODEL_PATH=/path/to/bge-reranker-v2-m3-int8.onnx
# RERANKER_IDLE_TIMEOUT_MS=120000
# RERANKER_CANDIDATE_WINDOW=15

# Data-at-rest Envelope Encryption (AES-256-GCM)
# Minimum 32-character high-entropy secret. Required in production.
# APP_SECRET=minimum-32-character-random-secret-for-data-at-rest-encryption

# ─── OOM / Memory Protection (Rule 07: Never Crash From Resource Exhaustion) ───
# These are read by the installer and baked into the systemd unit file (Linux)
# or launchd plist (macOS). NODE_OPTIONS is also read at runtime by the env
# schema. All are optional — sensible defaults are computed from system memory.

# cgroup hard memory limit for the background service (Linux only).
# Default: 80% of total system RAM. Set to 0 to disable.
# YGGDRASIL_MEMORY_MAX_BYTES=8589934592

# cgroup soft memory limit (Linux only). At this threshold the kernel begins
# reclaiming memory from the cgroup before the hard limit is reached.
# Default: 60% of total system RAM.
# YGGDRASIL_MEMORY_HIGH_BYTES=6442450944

# Kernel OOM-killer score adjustment for the service process.
# -1000 = never kill (default). Use a lower value (e.g. -500) on shared
# servers where you prefer this process to be expendable under pressure.
# YGGDRASIL_OOM_SCORE_ADJUST=-1000

# Maximum tasks (threads + processes) the cgroup may spawn. Default 512.
# YGGDRASIL_TASKS_MAX=512

# Node.js V8 heap ceiling in MB, passed via NODE_OPTIONS=--max-old-space-size=N.
# Default: auto-computed to 60% of system RAM (min 1024, max 8192).
# YGGDRASIL_NODE_MAX_OLD_SPACE_MB=4096

# Application-level proactive memory release threshold in MB. When available
# system memory drops below this, ONNX sessions are released proactively
# (Linux, macOS, and Windows). Default: 256.
# YGGDRASIL_MEMORY_PRESSURE_THRESHOLD_MB=256

# Workflow DevKit Local World storage. Must stay inside the project (Rule 06).
WORKFLOW_LOCAL_DATA_DIR=data/workflow


