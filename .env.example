# Provider secrets — one per provider id, referenced by apiKeyEnv in data/providers.json
# PROVIDER_SERVER_API_KEY=sk-...
# PROVIDER_<ID>_API_KEY=sk-...
# LLM_* vars below are deprecated first-boot seeds only; editing baseUrl in the UI now wins.
LLM_BASE_URL=http://localhost:20128/v1
LLM_MODEL_ID=ps/poolside/laguna-s-2.1
LLM_API_KEY=your_key_here

# Web & Image Search Providers (used by web_search and image_search tools)
# Any one is enough: the tools fall back through the enabled chain
# (Exa -> SearXNG -> Firecrawl) when a provider fails or runs out of
# quota. Provider priority, enable flags and key/URL overrides can also
# be managed in Settings -> Tools.
EXA_API_KEY=your_key_here
FIRECRAWL_API_KEY=your_key_here
# Self-hosted SearXNG instance (no API key). Enable the JSON format on
# the instance first: search.formats: [html, json] in its settings.yml.
# SEARXNG_BASE_URL=http://localhost:8080

# Neural Reranker (bge-reranker-v2-m3 ONNX INT8)
# Prebuilt and enabled by default. To activate cross-encoder reranking,
# manually download and place bge-reranker-v2-m3-int8.onnx (~544 MB) into data/models/
# When absent, the system automatically falls back to default cosine RRF.
# RERANKER_ENABLED=true
# RERANKER_MODEL_PATH=/path/to/bge-reranker-v2-m3-int8.onnx
# RERANKER_IDLE_TIMEOUT_MS=120000
# RERANKER_CANDIDATE_WINDOW=15

# Data-at-rest Envelope Encryption (AES-256-GCM)
# Minimum 32-character high-entropy secret. Required in production.
# APP_SECRET=minimum-32-character-random-secret-for-data-at-rest-encryption


