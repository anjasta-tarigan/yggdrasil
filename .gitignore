# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
.nyc_output

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
Thumbs.db
*.pem

# debug & logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
logs/
*.log

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# caches & local databases (keep inside project root, never $HOME)
#
# No trailing slash on `data`/`tmp`/`.cache`: the installer links `app/data`
# (and `app/.env`) as SYMLINKS, and a `data/` pattern matches directories only
# — never a symlink. With the slash, `git status` reports `?? data` in an
# installed checkout, which the update command reads as a dirty tree and
# refuses to proceed.
.cache
data
tmp
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.ses

# tooling local artifacts
.eslintcache
.turbo/
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# claude local artifacts
.claude/worktrees/
.claude/settings.local.json
.claude/*.lock
*.output

# playwright MCP browser-automation artifacts (Rule 05/06: local only)
.playwright-mcp/

# graphify knowledge graph output
graphify-out/

# vitest/vite scratch when the system tmpdir is unavailable (sandboxed runs)
.tmp-vitest/

# code-review / agent scratch artifacts (never commit generated diffs or logs)
.review-tmp/
.review-diff.txt
.mem-src-diff.txt
.tmp-*.log
.qc.log

# eval harness output
eval-results/

# root-level patch files (saved git patches should never be committed)
/*.patch

# Workflow DevKit Local World run data (Rule 06: never outside the project)
data/workflow/
/.swc

# Workflow DevKit build artifacts (written next to the workflow dir by the builder)
.workflow-vitest/
.workflow-data/
