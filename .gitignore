# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
.nyc_output

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
Thumbs.db
*.pem

# debug & logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
logs/
*.log

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# caches & local databases (keep inside project root, never $HOME)
.cache/
data/
tmp/
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.ses

# tooling local artifacts
.eslintcache
.turbo/
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# claude local artifacts
.claude/worktrees/
*.output

# graphify knowledge graph output
graphify-out/

# vitest/vite scratch when the system tmpdir is unavailable (sandboxed runs)
.tmp-vitest/

# code-review / agent scratch artifacts (never commit generated diffs or logs)
.review-tmp/
.review-diff.txt
.mem-src-diff.txt
.tmp-*.log
.qc.log
